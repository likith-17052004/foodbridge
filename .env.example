# Gemini on Vertex AI (recommended; on Cloud Run no key is needed, locally run `gcloud auth application-default login`)
VISION_PROVIDER=vertex
GOOGLE_CLOUD_PROJECT=socialone-468019
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.6-flash
# Alternative: Google AI Studio key with VISION_PROVIDER=gemini
GEMINI_API_KEY=
# 600 = 10 minutes per NGO, as in the spec. Use 60 for live demos.
OFFER_TIMEOUT_SECONDS=600
