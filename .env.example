# Gemini (Google AI Studio key) for local runs. Without it the app runs in demo mode.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Development alternative: the same Gemini model through OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.6-flash
# gemini / vertex / openrouter / demo (blank = auto: vertex > gemini > openrouter > demo)
VISION_PROVIDER=
# 600 = 10 minutes per NGO, as in the spec. Use 60 for live demos.
OFFER_TIMEOUT_SECONDS=600
